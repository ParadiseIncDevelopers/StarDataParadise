set(SDP_NATIVE_ARCHIVE "$ENV{SDP_NATIVE_ARCHIVE}" CACHE FILEPATH "Pinned StarDataParadiseDLLler Windows x64 ZIP")
if(NOT EXISTS "${SDP_NATIVE_ARCHIVE}")
    message(FATAL_ERROR "Provide the native SDK ZIP with -DSDP_NATIVE_ARCHIVE=<file>.")
endif()
file(SHA256 "${SDP_NATIVE_ARCHIVE}" native_digest)
if(native_digest STREQUAL "8073941b68c6c037ea646d4cc3f2bcc31445462356c9bd0db513b35cc2378041")
    set(native_version 0.4.1)
elseif(native_digest STREQUAL "4ee15b8fa50c94c5ee012245d8ed8e3c16259df64fc154ca15fb286cb6a8ad25")
    set(native_version 0.4.0)
else()
    message(FATAL_ERROR "Native SDK SHA-256 mismatch.")
endif()
set(native_root "${CMAKE_CURRENT_BINARY_DIR}/_deps/native-${native_version}")
file(MAKE_DIRECTORY "${native_root}")
file(ARCHIVE_EXTRACT INPUT "${SDP_NATIVE_ARCHIVE}" DESTINATION "${native_root}")
find_package(StarDataParadiseDLLler ${native_version} EXACT REQUIRED CONFIG
    PATHS "${native_root}" NO_DEFAULT_PATH)
set_target_properties(StarDataParadise::StarDataParadiseDLLler PROPERTIES
    MAP_IMPORTED_CONFIG_DEBUG Release)
